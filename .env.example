# Server-side only. Never expose this as a VITE_ variable.
OPENAI_API_KEY=your_openai_api_key

# Optional; this is the current default used by CareWeave.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional comma-separated extra origins for Realtime session creation.
# Same-origin requests from the deployed app are allowed automatically.
REALTIME_ALLOWED_ORIGINS=

# Defense-in-depth per warm Vercel Function instance. Also configure a
# distributed rate-limit rule for /api/realtime/session in Vercel Firewall.
REALTIME_RATE_LIMIT_PER_MINUTE=6

# Gmail OAuth web-application credentials. Server-side only; never prefix with VITE_.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Must exactly match a redirect URI registered in Google Cloud.
# Local: http://localhost:5173/api/gmail/callback
# Production: https://care-weave.vercel.app/api/gmail/callback
GOOGLE_OAUTH_REDIRECT_URI=

# At least 32 random characters. Encrypts each browser's Gmail refresh token
# inside an HttpOnly cookie scoped to /api/gmail.
GMAIL_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Supabase values used by the upcoming authenticated persistence integration.
# The project URL and publishable key are browser-safe; the secret key is not.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_value
SUPABASE_SECRET_KEY=sb_secret_your_value
